<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fushcasinaS6A.Views.vEstudiante"
             Title="vEstudiante">
    <VerticalStackLayout Padding="10"
                         Spacing="10">
        <Label
            Text="Semana 6: Servicios Web - Estudiante"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            FontSize="20"/>

        <!-- Muestra el error si no se puede conectar con XAMPP -->
        <Label x:Name="lblMensaje"
               TextColor="Red"
               HorizontalOptions="Center"/>

        <!-- Tabla: el fondo negro con espacio de 1 entre celdas dibuja los bordes -->
        <VerticalStackLayout>

            <!-- Encabezado de la tabla -->
            <Grid BackgroundColor="Black"
                  Padding="1"
                  ColumnSpacing="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <Label Text="Codigo"
                       BackgroundColor="Yellow"
                       TextColor="Navy"
                       FontAttributes="Bold"
                       Padding="5"
                       Grid.Column="0"/>
                <Label Text="Nombre"
                       BackgroundColor="Yellow"
                       TextColor="Navy"
                       FontAttributes="Bold"
                       Padding="5"
                       Grid.Column="1"/>
                <Label Text="Apellido"
                       BackgroundColor="Yellow"
                       TextColor="Navy"
                       FontAttributes="Bold"
                       Padding="5"
                       Grid.Column="2"/>
                <Label Text="Edad"
                       BackgroundColor="Yellow"
                       TextColor="Navy"
                       FontAttributes="Bold"
                       Padding="5"
                       Grid.Column="3"/>
            </Grid>

            <!-- Filas de la tabla: una por cada estudiante del servicio web -->
            <!-- Al tocar un estudiante se abre la ventana Actualizar/Eliminar -->
            <ListView x:Name="listaEstudiante"
                      SelectionMode="Single"
                      ItemSelected="listaEstudiante_ItemSelected"
                      SeparatorVisibility="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid BackgroundColor="Black"
                                  Padding="1,0,1,1"
                                  ColumnSpacing="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Label Text="{Binding codigo}"
                                       BackgroundColor="White"
                                       TextColor="Black"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       Padding="5"
                                       Grid.Column="0"/>
                                <Label Text="{Binding nombre}"
                                       BackgroundColor="White"
                                       TextColor="Black"
                                       VerticalTextAlignment="Center"
                                       Padding="5"
                                       Grid.Column="1"/>
                                <Label Text="{Binding apellido}"
                                       BackgroundColor="White"
                                       TextColor="Black"
                                       VerticalTextAlignment="Center"
                                       Padding="5"
                                       Grid.Column="2"/>
                                <Label Text="{Binding edad}"
                                       BackgroundColor="White"
                                       TextColor="Black"
                                       VerticalTextAlignment="Center"
                                       Padding="5"
                                       Grid.Column="3"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
            <Button x:Name="btnAgregarEstudiante"
                    Text="Agregar Estudiante"
                    Clicked="btnAgregarEstudiante_Clicked"/>

        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>
