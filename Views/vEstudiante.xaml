<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fushcasinaS6A.Views.vEstudiante"
             Title="vEstudiante">
    <VerticalStackLayout>
        <Label
            Text="Semana 6: Servicios Web - Estudiante"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            FontSize="20"/>

        <!-- Muestra el error si no se puede conectar con XAMPP -->
        <Label x:Name="lblMensaje"
               TextColor="Red"
               HorizontalOptions="Center"/>

        <ListView x:Name="listaEstudiante">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout>

                            <Label Text="{Binding nombre}"/>
                            <Label Text="{Binding apellido}"/>

                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </VerticalStackLayout>
</ContentPage>
