<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fushcasinaS6A.Views.vAgregarEstudiante"
             Title="vAgregarEstudiante">
    <VerticalStackLayout Padding="10"
                         Spacing="10">
        <Label 
            Text="Semana 7 - agregar estudiante"
            VerticalOptions="Center" 
            FontSize="20"
            HorizontalOptions="Center" />

        <Entry x:Name="txtNombre" Placeholder="ingresa el Nombre"/>
        <Entry x:Name="txtApellido" Placeholder="ingresa el Apellido"/>
        <Entry x:Name="txtEdad" Placeholder="ingresa la Edad" Keyboard="Numeric"/>

        <Grid ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnAgregar"
                    Text="Agregar"
                    Clicked="btnAgregar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0"/>
            <Button x:Name="btnCancelar"
                    Text="Cancelar"
                    Clicked="btnCancelar_Clicked"
                    Grid.Row="0"
                    Grid.Column="1"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>
